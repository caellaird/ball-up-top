{
  "name": "Thread",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "dm",
        "group"
      ],
      "default": "dm"
    },
    "name": {
      "type": "string"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "participant_ids"
  ]
}