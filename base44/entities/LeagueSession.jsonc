{
  "name": "LeagueSession",
  "type": "object",
  "properties": {
    "league_id": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "location_name": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "league_id",
    "start_time"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}