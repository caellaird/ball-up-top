{
  "name": "DailyQuestionAnswer",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string"
    },
    "selected_index": {
      "type": "number"
    },
    "is_correct": {
      "type": "boolean"
    },
    "points_earned": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "question_id",
    "selected_index"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}