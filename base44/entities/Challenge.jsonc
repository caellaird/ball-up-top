{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "sport": {
      "type": "string",
      "enum": [
        "basketball",
        "golf",
        "pickleball",
        "darts",
        "disc_golf",
        "cornhole",
        "trivia",
        "chugging",
        "custom"
      ],
      "default": "basketball"
    },
    "custom_sport_name": {
      "type": "string"
    },
    "custom_sport_emoji": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "opponent_id": {
      "type": "string"
    },
    "opponent_name": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "scheduled_time": {
      "type": "string",
      "format": "date-time"
    },
    "series_type": {
      "type": "string",
      "enum": [
        "single",
        "bo3",
        "bo5",
        "bo7",
        "open"
      ],
      "default": "single"
    },
    "series_name": {
      "type": "string"
    },
    "games_to_win": {
      "type": "number"
    },
    "creator_games_won": {
      "type": "number",
      "default": 0
    },
    "opponent_games_won": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "score_creator": {
      "type": "number"
    },
    "score_opponent": {
      "type": "number"
    },
    "winner_id": {
      "type": "string"
    },
    "winner_name": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "sport",
    "opponent_id",
    "opponent_name"
  ]
}