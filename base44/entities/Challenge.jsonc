{
  "name": "Challenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "head_to_head",
        "group",
        "streak",
        "skill",
        "trash_talk"
      ],
      "default": "head_to_head"
    },
    "creator_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "rules": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "cancelled"
      ],
      "default": "active"
    },
    "winner_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "start_date",
    "end_date"
  ]
}