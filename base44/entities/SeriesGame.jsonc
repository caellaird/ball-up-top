{
  "name": "SeriesGame",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "game_number": {
      "type": "number"
    },
    "score_creator": {
      "type": "number"
    },
    "score_opponent": {
      "type": "number"
    },
    "participant_scores": {
      "type": "array",
      "description": "Per-player scores for this game in a group (multiplayer) series",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "winner_name": {
      "type": "string"
    },
    "is_draw": {
      "type": "boolean",
      "default": false
    },
    "caption": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "challenge_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}