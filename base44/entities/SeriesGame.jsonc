{
  "name": "SeriesGame",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string"
    },
    "game_number": {
      "type": "number"
    },
    "score_creator": {
      "type": "number"
    },
    "score_opponent": {
      "type": "number"
    },
    "winner_name": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "challenge_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}