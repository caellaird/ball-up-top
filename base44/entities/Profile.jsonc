{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "nickname": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "description": "Home city picked by the player, stored as 'City, ST'"
    },
    "city_key": {
      "type": "string",
      "description": "Normalized city key used to credit this player's activity to their city, e.g. 'durham, nc'"
    },
    "city_display": {
      "type": "string",
      "description": "Display form of the player's city, e.g. 'Durham, NC'"
    },
    "favorite_team": {
      "type": "string"
    },
    "favorite_sport": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "enum": [
        "PG",
        "SG",
        "SF",
        "PF",
        "C",
        "Any"
      ]
    },
    "skill_level": {
      "type": "number",
      "default": 5
    },
    "ready_to_ball": {
      "type": "boolean",
      "default": false
    },
    "privacy_level": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ],
      "default": "public"
    },
    "last_lat": {
      "type": "number"
    },
    "last_lng": {
      "type": "number"
    },
    "notify_nearby": {
      "type": "boolean",
      "default": false
    },
    "notify_nearby_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notify_nearby_timing": {
      "type": "string",
      "enum": [
        "new",
        "approaching",
        "both"
      ],
      "default": "new"
    },
    "notif_challenge_invites": {
      "type": "boolean",
      "default": true
    },
    "notif_direct_messages": {
      "type": "boolean",
      "default": true
    },
    "notif_challenge_results": {
      "type": "boolean",
      "default": true
    },
    "notif_public_reminders": {
      "type": "boolean",
      "default": true
    },
    "notif_explore_favorites": {
      "type": "boolean",
      "default": true
    },
    "push_enabled": {
      "type": "boolean",
      "default": true
    },
    "current_rival_id": {
      "type": "string",
      "description": "Manually selected rivalry ID to display as Current Rival on profile"
    }
  },
  "required": [
    "username"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}