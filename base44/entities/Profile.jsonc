{
  "name": "Profile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "favorite_team": {
      "type": "string"
    },
    "favorite_sport": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "enum": [
        "PG",
        "SG",
        "SF",
        "PF",
        "C",
        "Any"
      ]
    },
    "skill_level": {
      "type": "number",
      "default": 5
    },
    "ready_to_ball": {
      "type": "boolean",
      "default": false
    },
    "privacy_level": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "private"
      ],
      "default": "public"
    }
  },
  "required": [
    "username"
  ]
}