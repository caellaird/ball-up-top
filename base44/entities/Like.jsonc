{
  "name": "Like",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83d\udd25",
      "description": "A single emoji reaction chosen by the user for this post"
    }
  },
  "required": [
    "post_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}