{
  "name": "CityYearScore",
  "type": "object",
  "properties": {
    "city_key": {
      "type": "string",
      "description": "Normalized lowercase key, e.g. 'durham, nc'"
    },
    "city_display": {
      "type": "string",
      "description": "Display name, e.g. 'Durham, NC'"
    },
    "year": {
      "type": "number",
      "description": "Calendar year the points belong to, e.g. 2026"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Total city points earned this year"
    }
  },
  "required": [
    "city_key",
    "year"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}