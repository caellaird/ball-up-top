{
  "name": "CityYearScore",
  "type": "object",
  "properties": {
    "city_key": {
      "type": "string",
      "description": "Normalized lowercase key, e.g. 'durham, nc'"
    },
    "city_display": {
      "type": "string",
      "description": "Display name, e.g. 'Durham, NC'"
    },
    "year": {
      "type": "number",
      "description": "Calendar year the points belong to, e.g. 2026"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Total city points earned this year"
    }
  },
  "required": [
    "city_key",
    "year"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}