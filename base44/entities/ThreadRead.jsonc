{
  "name": "ThreadRead",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_read_at": {
      "type": "string",
      "format": "date-time"
    },
    "typing_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "thread_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participant_ids": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}