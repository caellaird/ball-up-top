{
  "name": "StateChallengeScore",
  "type": "object",
  "properties": {
    "state_code": {
      "type": "string",
      "description": "Two-letter state abbreviation, e.g. 'NC'"
    },
    "state_name": {
      "type": "string",
      "description": "Full state name, e.g. 'North Carolina'"
    },
    "completed_count": {
      "type": "number",
      "default": 0,
      "description": "Completed challenges credited to this state"
    }
  },
  "required": [
    "state_code"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}