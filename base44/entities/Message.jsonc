{
  "name": "Message",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_username": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "reply_to_id": {
      "type": "string"
    },
    "reply_to_sender": {
      "type": "string"
    },
    "reply_to_body": {
      "type": "string"
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
