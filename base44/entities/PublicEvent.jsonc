{
  "name": "PublicEvent",
  "type": "object",
  "properties": {
    "competition_type": {
      "type": "string"
    },
    "custom_sport_name": {
      "type": "string"
    },
    "custom_sport_emoji": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "verified_address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "ended"
      ],
      "default": "active"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public"
      ],
      "default": "public"
    },
    "share_to_friends": {
      "type": "boolean",
      "default": false
    },
    "chat_id": {
      "type": "string"
    },
    "accepted_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "competition_type",
    "latitude",
    "longitude",
    "start_datetime"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}