{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_username": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community_id": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "game_emoji": {
      "type": "string"
    },
    "sport_label": {
      "type": "string"
    },
    "challenge_type": {
      "type": "string",
      "enum": [
        "single",
        "series"
      ]
    },
    "location_name": {
      "type": "string"
    },
    "score_text": {
      "type": "string"
    },
    "tagged_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tagged_user_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tagged_usernames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "fire_count": {
      "type": "number",
      "default": 0
    },
    "trash_count": {
      "type": "number",
      "default": 0
    },
    "trophy_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "is_edited": {
      "type": "boolean",
      "default": false
    },
    "post_type": {
      "type": "string",
      "enum": [
        "standard",
        "rivalry_announcement",
        "rivalry_milestone",
        "highlight_card"
      ],
      "default": "standard"
    },
    "rivalry_id": {
      "type": "string"
    },
    "highlight_title": {
      "type": "string",
      "description": "Event/league name for a highlight card post, e.g. 'Tuesday Night Hoops'"
    },
    "highlight_stats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "description": "1-3 custom stat rows displayed on a highlight card"
    }
  },
  "required": [
    "author_name",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}