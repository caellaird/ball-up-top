{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community_id": {
      "type": "string"
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "author_name",
    "body"
  ]
}