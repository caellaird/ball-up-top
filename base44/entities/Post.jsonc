  "properties": {
    "author_name": {
      "type": "string"
    },
    "author_username": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "community_id": {
      "type": "string"
    },
    "challenge_id": {
      "type": "string"
    },
    "game_emoji": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "score_text": {
      "type": "string"
    },
    "tagged_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tagged_user_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tagged_usernames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "like_count": {
      "type": "number",
      "default": 0
    },
    "fire_count": {
      "type": "number",
      "default": 0
    },
    "trash_count": {
      "type": "number",
      "default": 0
    },
    "comment_count": {
      "type": "number",
      "default": 0
    }
