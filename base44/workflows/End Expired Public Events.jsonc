{
  "description": "Auto-ends active public events 2 hours after their start time. Runs every 5 minutes; the backend function flips each expired event's status to `ended`, removing it from Explore and moving it to the Challenges Completed tab.",
  "name": "End Expired Public Events",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "end_expired_public_events",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "end_expired": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "endExpiredPublicEvents",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "End expired public events",
            "description": "Flip active events past start+2h to ended"
          }
        }
      }
    ]
  }
}